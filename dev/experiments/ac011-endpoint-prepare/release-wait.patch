+#[cfg(all(feature = "test-hooks", target_os = "linux"))]
+pub(crate) mod wait_diagnostic {
+    use std::cell::RefCell;
+    use std::time::Instant;
+
+    const NAMES: [&str; 8] = [
+        "turn_wait",
+        "writer_mutex_wait",
+        "pretransaction",
+        "begin",
+        "trigger_check_disable",
+        "apply_body",
+        "visibility_advance_restore",
+        "commit",
+    ];
+
+    #[derive(Clone, Copy, Default)]
+    struct Metric {
+        wall_ns: u128,
+        cpu_ns: u128,
+        intervals: u64,
+        samples: u64,
+    }
+
+    #[derive(Default)]
+    struct Current {
+        metrics: [Metric; 8],
+        successful: bool,
+    }
+
+    #[derive(Default)]
+    struct State {
+        current: Option<Current>,
+        metrics: [Metric; 8],
+        commits: u64,
+        write_wall_ns: u128,
+        write_cpu_ns: u128,
+    }
+
+    thread_local! { static STATE: RefCell<Option<State>> = const { RefCell::new(None) }; }
+
+    fn cpu_ns() -> u128 {
+        let mut time = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+        // The kernel writes one initialized timespec for the calling thread only.
+        let status = unsafe { libc::clock_gettime(libc::CLOCK_THREAD_CPUTIME_ID, &mut time) };
+        assert_eq!(status, 0, "CLOCK_THREAD_CPUTIME_ID unavailable");
+        u128::try_from(time.tv_sec).unwrap() * 1_000_000_000 + u128::try_from(time.tv_nsec).unwrap()
+    }
+
+    struct Stamp {
+        wall: Instant,
+        cpu_ns: u128,
+    }
+
+    impl Stamp {
+        fn now() -> Self {
+            Self { wall: Instant::now(), cpu_ns: cpu_ns() }
+        }
+        fn elapsed(&self) -> (u128, u128) {
+            let cpu = cpu_ns() - self.cpu_ns;
+            (self.wall.elapsed().as_nanos(), cpu)
+        }
+    }
+
+    pub(crate) struct Interval {
+        index: usize,
+        started: Stamp,
+    }
+
+    impl Drop for Interval {
+        fn drop(&mut self) {
+            let (wall, cpu) = self.started.elapsed();
+            STATE.with(|state| {
+                let mut state = state.borrow_mut();
+                let metric =
+                    &mut state.as_mut().unwrap().current.as_mut().unwrap().metrics[self.index];
+                metric.wall_ns += wall;
+                metric.cpu_ns += cpu;
+                metric.intervals += 1;
+            });
+        }
+    }
+
+    pub(crate) fn stage(index: usize) -> Option<Interval> {
+        STATE.with(|state| {
+            state
+                .borrow()
+                .as_ref()
+                .and_then(|s| s.current.as_ref())
+                .map(|_| Interval { index, started: Stamp::now() })
+        })
+    }
+
+    pub(crate) struct WriteSample {
+        started: Stamp,
+    }
+
+    pub(crate) fn sample() -> Option<WriteSample> {
+        STATE.with(|state| {
+            state.borrow_mut().as_mut().map(|state| {
+                assert!(state.current.is_none(), "nested diagnostic write");
+                state.current = Some(Current::default());
+                WriteSample { started: Stamp::now() }
+            })
+        })
+    }
+
+    pub(crate) fn success() {
+        STATE.with(|state| {
+            if let Some(current) = state.borrow_mut().as_mut().and_then(|s| s.current.as_mut()) {
+                current.successful = true;
+            }
+        });
+    }
+
+    impl Drop for WriteSample {
+        fn drop(&mut self) {
+            let (wall, cpu) = self.started.elapsed();
+            STATE.with(|state| {
+                let mut state = state.borrow_mut();
+                let state = state.as_mut().unwrap();
+                let current = state.current.take().unwrap();
+                if !current.successful {
+                    return;
+                }
+                state.commits += 1;
+                state.write_wall_ns += wall;
+                state.write_cpu_ns += cpu;
+                for (total, interval) in state.metrics.iter_mut().zip(current.metrics) {
+                    total.wall_ns += interval.wall_ns;
+                    total.cpu_ns += interval.cpu_ns;
+                    total.intervals += interval.intervals;
+                    total.samples += u64::from(interval.intervals > 0);
+                }
+            });
+        }
+    }
+
+    pub(crate) fn enable() {
+        STATE.with(|state| *state.borrow_mut() = Some(State::default()));
+    }
+
+    pub(crate) fn take() -> serde_json::Value {
+        let state = STATE.with(|state| state.borrow_mut().take().unwrap());
+        assert!(state.current.is_none(), "diagnostic write still active");
+        let exclusive_wall: u128 = state.metrics.iter().map(|m| m.wall_ns).sum();
+        let exclusive_cpu: u128 = state.metrics.iter().map(|m| m.cpu_ns).sum();
+        let residual_wall = state.write_wall_ns as i128 - exclusive_wall as i128;
+        let residual_cpu = state.write_cpu_ns as i128 - exclusive_cpu as i128;
+        let stages: Vec<_> = NAMES
+            .iter()
+            .zip(state.metrics)
+            .map(|(name, m)| {
+                serde_json::json!({
+                    "stage": name, "sample_count": m.samples, "interval_count": m.intervals,
+                    "wall_ns": m.wall_ns, "thread_cpu_ns": m.cpu_ns,
+                    "non_cpu_ns": m.wall_ns as i128 - m.cpu_ns as i128,
+                })
+            })
+            .collect();
+        serde_json::json!({
+            "successful_commits": state.commits,
+            "write_wall_ns": state.write_wall_ns,
+            "write_thread_cpu_ns": state.write_cpu_ns,
+            "write_non_cpu_ns": state.write_wall_ns as i128 - state.write_cpu_ns as i128,
+            "exclusive_wall_ns": exclusive_wall,
+            "exclusive_thread_cpu_ns": exclusive_cpu,
+            "uncovered_wall_ns": residual_wall,
+            "uncovered_thread_cpu_ns": residual_cpu,
+            "uncovered_non_cpu_ns": residual_wall - residual_cpu,
+            "negative_residual": residual_wall < 0 || residual_cpu < 0 || residual_wall - residual_cpu < 0,
+            "stages": stages,
+        })
+    }
+}
