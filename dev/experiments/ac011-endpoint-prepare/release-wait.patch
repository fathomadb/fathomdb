+#[cfg(target_os = "linux")]
+#[test]
+#[ignore = "diagnostic only; reserve an isolated execution slot"]
+fn ac_011_release_foreground_wall_cpu_diagnostic() {
+    let parameter = |name: &str, default: u64| {
+        std::env::var(name)
+            .map_or(default, |v| v.parse::<u64>().expect("unsigned diagnostic parameter"))
+    };
+    let warmup_ms = parameter("AC011_WAIT_WARMUP_MS", 5_000);
+    let measurement_ms = parameter("AC011_WAIT_MEASUREMENT_MS", 60_000);
+    let payload_bytes = parameter("AC011_WAIT_PAYLOAD_BYTES", 1_024);
+    assert!(measurement_ms > 0 && payload_bytes > 0);
+    let (_dir, path) = fixture_path("AC011_release_foreground_wall_cpu");
+    let opened = Engine::open(&path).expect("open write-throughput fixture");
+    let write = PreparedWrite::Node {
+        kind: "throughput".to_string(),
+        body: "x".repeat(usize::try_from(payload_bytes).unwrap()),
+        source_id: fathomdb_engine::SourceId::new("test:ac011").expect("test source id"),
+        logical_id: None,
+        state: fathomdb_engine::InitialState::Active,
+        reason: None,
+        valid_from: None,
+        valid_until: None,
+    };
+    let warmup_deadline = Instant::now() + Duration::from_millis(warmup_ms);
+    while Instant::now() < warmup_deadline {
+        opened.engine.write(std::slice::from_ref(&write)).expect("warmup commit");
+    }
+    opened.engine.start_write_wait_diagnostic_for_test();
+    let started = Instant::now();
+    let deadline = started + Duration::from_millis(measurement_ms);
+    let mut commits = 0_u64;
+    while Instant::now() < deadline {
+        opened.engine.write(std::slice::from_ref(&write)).expect("measured commit");
+        commits += 1;
+    }
+    let elapsed = started.elapsed();
+    let foreground = opened.engine.take_write_wait_diagnostic_for_test();
+    eprintln!(
+        "AC011_RELEASE_WAIT {}",
+        serde_json::json!({
+            "diagnostic_only": true, "fixture_path": path,
+            "warmup_ms": warmup_ms, "measurement_ms": measurement_ms,
+            "payload_bytes": payload_bytes, "commits": commits,
+            "elapsed_ns": elapsed.as_nanos(),
+            "diagnostic_commits_per_second": commits as f64 / elapsed.as_secs_f64(),
+            "foreground": foreground,
+        })
+    );
+    assert_eq!(foreground["successful_commits"].as_u64(), Some(commits));
+    for stage in foreground["stages"].as_array().unwrap() {
+        assert_eq!(stage["sample_count"].as_u64(), Some(commits));
+        let intervals = if stage["stage"] == "visibility_advance_restore" { 2 } else { 1 };
+        assert_eq!(stage["interval_count"].as_u64(), Some(commits * intervals));
+    }
+}
