## runner build-a.sh
set -u
. ~/fathomdb-slice31/orin-env.sh
T=e9036a912442
SRC=$W/src-$T
A=$W/artifacts; mkdir -p $A
export CARGO_TARGET_DIR=$W/target-$T
orin_guard before-build-a || exit 3
step() { echo "=== $1 $(date -u +%T)"; }
cd $SRC
step pool-va-tests
cargo test --locked --no-run -p fathomdb-embedder --features embed-cuda --test tegra_fragmented_va_cuda 2>&1 | tail -3
step cli-c1
cargo build --locked --release -p fathomdb-cli --features embed-cuda,rerank-cuda,tegra-pool --message-format=json >$A/cli-build.json 2>$A/cli-build.err; echo "cli rc=$?"
python3 -I -c "import json,sys; d={m[\"out_dir\"] for m in map(json.loads,sys.stdin) if m.get(\"reason\")==\"build-script-executed\" and \"candle-kernels\" in m[\"package_id\"]}; assert len(d)==1, d; print(d.pop())" <$A/cli-build.json >$A/c1-out-dir.txt; echo "c1-outdir rc=$? $(cat $A/c1-out-dir.txt)"
step wheel
PATH=$HOME/ci-runs/fathomdb-jetson-local-20260820T120312Z-541352/build-venv/bin:$PATH \
  bash scripts/release/build-python-cuda-tegra.sh --out $A/wheel --interpreter /usr/bin/python3 2>&1 | tail -12
rm -rf $W/venv-tip; /usr/bin/python3 -m venv $W/venv-tip && $W/venv-tip/bin/pip install -q --disable-pip-version-check --no-deps --no-index $A/wheel/fathomdb-*.whl; echo "venv rc=$?"
build_node() { # src target consumer-dir tag
  local src=$1 tgt=$2 consumer=$3 tag=$4
  ( . ~/.nvm/nvm.sh >/dev/null && nvm use 25.9.0 >/dev/null
    cd $src/src/ts && npm ci --no-audit --no-fund >/dev/null 2>&1; echo "npm ci rc=$?"
    npx tsc -p tsconfig.build.json; echo "tsc rc=$?"
    CARGO_TARGET_DIR=$tgt npm exec -- napi build --platform --release --cargo-cwd ../rust/crates/fathomdb-napi \
      --features embed-cuda,rerank-cuda,tegra-pool --js false 2>&1 | tail -3; echo "napi rc=${PIPESTATUS[0]}"
    rm -rf $A/platform-$tag; cp -a npm/linux-arm64-gnu $A/platform-$tag && cp fathomdb.linux-arm64-gnu.node $A/platform-$tag/
    rm -rf $A/staging-$tag $consumer
    bash $SRC/dev/plans/runs/0.8.28-slice-31/harness/stage-installed.sh $src $A/platform-$tag $A/staging-$tag $consumer 2>&1 | tail -5 )
}
step node-tip
build_node $SRC $CARGO_TARGET_DIR $W/node-tip tip
step node-base
build_node $W/src-base $W/target-base $W/node-base base
orin_guard after-build-a || exit 3
step BUILD-A-DONE
## runner run-a.sh
set -u
. ~/fathomdb-slice31/orin-env.sh
T=e9036a912442
SRC=$W/src-$T
A=$W/artifacts
export CARGO_TARGET_DIR=$W/target-$T
L=$W/logs-a; mkdir -p $L
cd $SRC
exec 9>/tmp/fathomdb-gpu.lock
echo "waiting for lock $(date -u +%T)"; flock 9; echo "lock held $(date -u +%T)"
g() { orin_guard "$1" || { echo GUARD-STOP; exit 3; }; }
cell() { # id logname cmd...
  local id=$1 log=$2; shift 2
  g before-$id
  "$@" >"$L/$log.log" 2>&1 9>&-
  local rc=$?
  echo "$id $log rc=$rc" | tee -a $L/summary.txt
  g after-$id
}
lib() { env FATHOMDB_REQUIRE_LIVE=1 FATHOMDB_EMBED_DEVICE=cuda:0 cargo test --locked -p fathomdb-embedder \
  --features embed-cuda,tegra-pool --lib -- --ignored --exact "$1" --nocapture --test-threads=1; }
cell POOL-01 pool-va env FATHOMDB_REQUIRE_LIVE=1 cargo test --locked -p fathomdb-embedder --features embed-cuda \
  --test tegra_fragmented_va_cuda -- --exact forced_cuda_probe_succeeds_when_the_default_memory_pool_is_unavailable --nocapture
for t in gpu_orin_64_builds_every_device_on_a_three_gib_private_pool gpu_orin_64_pool_stays_under_max_size_and_is_empty_after_the_embedder_drops gpu_orin_64_a_primary_context_reset_is_context_lost_and_teardown_segfaults; do
  cell POOL-lib $t lib cuda_pool_policy::tests::$t
done
for t in gpu_orin_64_dropping_the_embedder_releases_pool_memory_without_a_caller_synchronize gpu_orin_64_close_release_also_trims_a_max_threshold_pool gpu_orin_64_process_exit_with_the_private_pool_alive_is_clean gpu_orin_64_dropping_the_embedder_then_exiting_is_clean gpu_orin_64_records_the_usable_capacity_of_the_three_gib_pool gpu_orin_64_memory_outside_the_private_pool_is_recorded; do
  cell S31 $t lib cuda_pool_policy::slice31_tests::$t
done
cell ORIN-14-cpu d14-cpu-control env FATHOMDB_REQUIRE_LIVE=1 FATHOMDB_EMBED_DEVICE=cpu cargo test --locked -p fathomdb-embedder \
  --features embed-cuda,tegra-pool --lib -- --ignored --exact cuda_pool_policy::slice31_tests::gpu_orin_64_memory_outside_the_private_pool_is_recorded --nocapture --test-threads=1
cell TDN-03 engine-close env FATHOMDB_REQUIRE_LIVE=1 cargo test --locked -p fathomdb-engine --features embed-cuda,tegra-pool \
  --test slice31_engine_close_cuda -- --ignored --exact gpu_orin_64_engine_close_with_the_private_pool_then_exit_is_clean --nocapture --test-threads=1
mkdir -p $W/fork-tests && cp src/python/tests/test_tegra_pool_fork_after_init.py $W/fork-tests/
cell TDN-06-10 fork bash -c "cd $W/fork-tests && FATHOMDB_REQUIRE_LIVE=1 PYTHONPATH=$HOME/.local/lib/python3.10/site-packages $W/venv-tip/bin/python -m pytest -v -p no:cacheprovider -c /dev/null --rootdir $W/fork-tests test_tegra_pool_fork_after_init.py"
cell ORIN-12 node-e2e bash -c ". ~/.nvm/nvm.sh >/dev/null && nvm use 25.9.0 >/dev/null && FATHOMDB_TEGRA_NODE_PACKAGE=$W/node-tip/node_modules/fathomdb FATHOMDB_TEGRA_EARLY_CUINIT_RUNS=5 FATHOMDB_REQUIRE_LIVE=1 bash scripts/tests/test_tegra_node_early_cuinit.sh"
EXT=$(find $A/wheel/unpacked -name "*.so" | head -1)
cell ORIN-15 linkage-wheel bash scripts/release/check-tegra-wheel-linkage.sh "$EXT"
cell ORIN-15 linkage-node bash scripts/release/check-tegra-wheel-linkage.sh $W/node-tip/node_modules/fathomdb-linux-arm64-gnu/fathomdb.linux-arm64-gnu.node
cell CMP-C1b c1 bash -c "python3 scripts/check-ptx-driver-floor.py --ptx-dir \"\$(cat $A/c1-out-dir.txt)\" --target sm_87 || ~/.local/bin/python3.12 scripts/check-ptx-driver-floor.py --ptx-dir \"\$(cat $A/c1-out-dir.txt)\" --target sm_87"
cell REG-bc reg-off env CARGO_TARGET_DIR=$W/target-reg LIBRARY_PATH=/usr/local/cuda/lib64 FATHOMDB_REQUIRE_LIVE=1 FATHOMDB_POOL_MODE=off bash scripts/check-tegra-pool-registry-build.sh
cell REG-c-info reg-auto env -u FATHOMDB_POOL_MODE CARGO_TARGET_DIR=$W/target-reg LIBRARY_PATH=/usr/local/cuda/lib64 FATHOMDB_REQUIRE_LIVE=1 bash scripts/check-tegra-pool-registry-build.sh
echo "WINDOW-A-DONE $(date -u +%T)"
