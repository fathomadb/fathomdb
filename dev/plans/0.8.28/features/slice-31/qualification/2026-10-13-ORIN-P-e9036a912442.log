## runner build-p.sh
set -u
. ~/fathomdb-slice31/orin-env.sh
T=e9036a912442
cd $W/src-$T
export CARGO_TARGET_DIR=$W/target-$T
orin_guard before-build-p
cargo test --locked --no-run -p fathomdb-embedder --features embed-cuda,tegra-pool --lib 2>&1 | tail -40; echo "rc-emb=${PIPESTATUS[0]}"
cargo test --locked --no-run -p fathomdb-engine --features embed-cuda,tegra-pool --test slice31_engine_close_cuda 2>&1 | tail -40; echo "rc-eng=${PIPESTATUS[0]}"
orin_guard after-build-p
echo BUILD-DONE
## runner window-p.sh
set -u
. ~/fathomdb-slice31/orin-env.sh
T=e9036a912442
cd $W/src-$T
export CARGO_TARGET_DIR=$W/target-$T
L=$W/logs-p; mkdir -p $L
exec 9>/tmp/fathomdb-gpu.lock
echo "waiting for lock $(date -u +%T)"; flock 9; echo "lock held $(date -u +%T)"
run_lib() { # name
  orin_guard "before-$1" || exit 3
  env FATHOMDB_REQUIRE_LIVE=1 FATHOMDB_EMBED_DEVICE=cuda:0 cargo test --locked -p fathomdb-embedder \
    --features embed-cuda,tegra-pool --lib -- --ignored --exact "cuda_pool_policy::slice31_tests::$1" \
    --nocapture --test-threads=1 >"$L/$1.log" 2>&1
  echo "$1 rc=$?" | tee -a $L/summary.txt
  orin_guard "after-$1" || exit 3
}
run_lib gpu_orin_64_dropping_the_embedder_releases_pool_memory_without_a_caller_synchronize
run_lib gpu_orin_64_close_release_also_trims_a_max_threshold_pool
run_lib gpu_orin_64_process_exit_with_the_private_pool_alive_is_clean
run_lib gpu_orin_64_dropping_the_embedder_then_exiting_is_clean
t=gpu_orin_64_engine_close_with_the_private_pool_then_exit_is_clean
orin_guard "before-$t" || exit 3
env FATHOMDB_REQUIRE_LIVE=1 cargo test --locked -p fathomdb-engine --features embed-cuda,tegra-pool \
  --test slice31_engine_close_cuda -- --ignored --exact $t --nocapture --test-threads=1 >"$L/$t.log" 2>&1
echo "$t rc=$?" | tee -a $L/summary.txt
orin_guard "after-$t" || exit 3
echo "WINDOW-P-DONE $(date -u +%T)"
## orin-env.sh
# Slice 31 Orin build/run env (test-plan § 1.2). Sourced.
export PATH="$HOME/.cargo/bin:/usr/local/cuda-12.6/bin:$PATH"
export CUDA_COMPUTE_CAP=87 CUDARC_CUDA_VERSION=12060 CUDA_PATH=/usr/local/cuda-12.6
export LIBRARY_PATH=/usr/local/cuda/targets/aarch64-linux/lib
W=$HOME/fathomdb-slice31
GUARD_LOG=${GUARD_LOG:-$W/guard.log}
orin_guard() {
  local rel cuda
  rel="$(head -1 /etc/nv_tegra_release)"; cuda="$(readlink -f /usr/local/cuda)"
  printf '%s %s | %s | %s\n' "$(date -u +%FT%TZ)" "$1" "$rel" "$cuda" >>"$GUARD_LOG"
  case "$rel" in "# R36 (release), REVISION: 5.2,"*) ;; *) echo "GUARD CHANGED: $rel" >&2; return 3;; esac
  [ "$cuda" = /usr/local/cuda-12.6 ] || { echo "GUARD CHANGED: $cuda" >&2; return 3; }
}
