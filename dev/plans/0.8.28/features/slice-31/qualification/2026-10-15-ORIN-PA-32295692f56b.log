## runner parity.py
"""Slice 31 Orin parity matrix, Python column: one mode per process."""
import sys
import tempfile
from pathlib import Path

import fathomdb
from fathomdb import Engine
from fathomdb.errors import InvalidArgumentError

mode = sys.argv[1]
root = Path(tempfile.mkdtemp(prefix="fdb-parity-py-"))
kw = {
    "default": {},
    "pool-off": {"cuda_pool": "off"},
    "pool-on": {"cuda_pool": "on"},
    "max": {"cuda_pool_release_threshold": "max"},
    "size-sdk": {"cuda_pool_max_size": 1 << 30},
    "size-huge": {"cuda_pool_max_size": 1 << 40},
}.get(mode, {})
if mode == "cls-then-off":
    fathomdb.embed_batch_cls(["a module-level embed first"])
    try:
        Engine.open(str(root / "c.sqlite"), use_default_embedder=True, cuda_pool="off")
    except InvalidArgumentError as error:
        print(f"py-child: conflict {error}")
        sys.exit(0)
    sys.exit("py-child: no conflict")
engine = Engine.open(str(root / "p.sqlite"), use_default_embedder=True, **kw)
r = engine.open_report().embedder_device_resolution.effective_device.cuda_device.cuda_allocator
print(f"py-child: path={r.path} reason={r.reason} module_load_init={r.module_load_init} "
      f"pool_mode={r.pool_mode} pool_mode_source={r.pool_mode_source}")
print(f"py-child: pool_max_size_bytes={r.pool_max_size_bytes} pool_max_size_source={r.pool_max_size_source} "
      f"release_threshold={r.release_threshold} pool_release_threshold_source={r.pool_release_threshold_source}")
vec = engine.embed("the private pool parity row")
print(f"py-child: embedded dim={len(vec)}")
engine.close()
print("py-child: closed")

## runner parity.mjs
// Slice 31 Orin parity matrix, Node column: one mode per process.
// Run from the installed consumer directory (node-tip).
import { mkdtempSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
const { Engine, embedBatchCls, InvalidArgumentError } = await import("fathomdb");
const mode = process.argv[2];
const dir = mkdtempSync(join(tmpdir(), "fdb-parity-node-"));
const configs = {
  default: {},
  "pool-off": { cudaPool: "off" },
  "pool-on": { cudaPool: "on" },
  max: { cudaPoolReleaseThreshold: "max" },
  "size-sdk": { cudaPoolMaxSize: 1 << 30 },
  "size-huge": { cudaPoolMaxSize: 2 ** 40 },
};
if (mode === "cls-then-off") {
  await embedBatchCls(["a module-level embed first"]);
  try {
    await Engine.open(join(dir, "c.sqlite"), { useDefaultEmbedder: true, engineConfig: { cudaPool: "off" } });
    console.log("node-child: no conflict"); process.exit(1);
  } catch (error) {
    if (!(error instanceof InvalidArgumentError)) throw error;
    console.log(`node-child: conflict ${error.message}`); process.exit(0);
  }
}
const engine = await Engine.open(join(dir, "p.sqlite"), { useDefaultEmbedder: true, engineConfig: configs[mode] ?? {} });
const r = engine.openReport().embedderDeviceResolution.effectiveDevice.cudaDevice.cudaAllocator;
console.log(`node-child: path=${r.path} reason=${r.reason} module_load_init=${r.moduleLoadInit} pool_mode=${r.poolMode} pool_mode_source=${r.poolModeSource}`);
console.log(`node-child: pool_max_size_bytes=${r.poolMaxSizeBytes} pool_max_size_source=${r.poolMaxSizeSource} release_threshold=${r.releaseThreshold} pool_release_threshold_source=${r.poolReleaseThresholdSource}`);
const vec = await engine.embed("the private pool parity row");
console.log(`node-child: embedded dim=${vec.length}`);
await engine.close();
console.log("node-child: closed");
