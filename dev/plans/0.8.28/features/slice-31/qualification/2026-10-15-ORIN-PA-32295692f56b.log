exec 9>/tmp/fathomdb-gpu.lock
echo "waiting for lock $(date -u +%T)"; flock 9; echo "lock held $(date -u +%T)"
g() { orin_guard "$1" || { echo GUARD-STOP; exit 3; }; }
cell() { # id logname cmd...
  local id=$1 log=$2; shift 2
  g before-$id-$log
  "$@" >"$L/$log.log" 2>&1 9>&-
  local rc=$?
  echo "$id $log rc=$rc" | tee -a $L/summary.txt
  g after-$id-$log
}
lib() { env FATHOMDB_REQUIRE_LIVE=1 FATHOMDB_EMBED_DEVICE=cuda:0 cargo test --locked -p fathomdb-embedder \
  --features embed-cuda --lib -- --ignored --exact "$1" --nocapture --test-threads=1; }
sdk() { env FATHOMDB_REQUIRE_LIVE=1 cargo test --locked -p fathomdb-sdk --features embed-cuda \
  --test slice31_sdk_probe_init_cuda -- --ignored --exact "$1" --nocapture --test-threads=1; }
