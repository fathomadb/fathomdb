#!/usr/bin/env bash
# usage: build-arm.sh <copy> <target-dir> <log>
set -euo pipefail
copy=$1; tgt=$2
source ~/.nvm/nvm.sh >/dev/null && nvm use 25.9.0 >/dev/null
echo "node=$(node --version) npm=$(npm --version) copy=$copy sha=$(git -C $copy rev-parse HEAD) CARGO_TARGET_DIR=$tgt"
cd "$copy/src/ts"
npm ci --no-audit --no-fund
export CARGO_TARGET_DIR=$tgt
time npm run build:native:cuda
npx tsc -p tsconfig.build.json
ls -la fathomdb.linux-x64-gnu.node
cp fathomdb.linux-x64-gnu.node npm/linux-x64-gnu/
sha256sum fathomdb.linux-x64-gnu.node npm/linux-x64-gnu/fathomdb.linux-x64-gnu.node
echo BUILD-OK
