+
+// EARLY-INIT EXPERIMENT ONLY BEGIN
+#[cfg(feature = "embed-cuda")]
+static EXP_EARLY_INIT_LOG: std::sync::OnceLock<Option<String>> = std::sync::OnceLock::new();
+
+#[cfg(feature = "embed-cuda")]
+#[napi::module_init]
+fn exp_early_init() {
+    let line = std::panic::catch_unwind(cudarc::driver::slice110_early_init)
+        .unwrap_or_else(|_| Some("early-init panicked".to_string()));
+    if let Some(l) = &line {
+        eprintln!("{l}");
+    }
+    let _ = EXP_EARLY_INIT_LOG.set(line);
+}
+
+#[cfg(feature = "embed-cuda")]
+#[napi_derive::napi(js_name = "expEarlyInitLog")]
+pub fn exp_early_init_log() -> Option<String> {
+    EXP_EARLY_INIT_LOG.get().cloned().flatten()
+}
+
+#[cfg(feature = "embed-cuda")]
+#[napi_derive::napi(js_name = "expCudaProbe")]
+pub fn exp_cuda_probe(sizes_mib: Vec<u32>, query_default_pool: bool) -> String {
+    let sizes: Vec<u64> = sizes_mib.iter().map(|m| u64::from(*m) << 20).collect();
+    std::panic::catch_unwind(|| cudarc::driver::slice110_health_probe(&sizes, query_default_pool))
+        .unwrap_or_else(|_| "probe panicked".to_string())
+}
+// EARLY-INIT EXPERIMENT ONLY END
