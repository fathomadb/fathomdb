{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FathomDB unmerged CUDA candidate manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidates"],
  "properties": {
    "schema_version": {"const": "fathomdb.cuda-unmerged-candidates/v1"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "candidate_sha",
          "candidate_pr",
          "candidate_pr_head_sha",
          "required_reviewers",
          "expires_at",
          "purpose",
          "provenance_pr",
          "provenance_commit",
          "provenance_required_reviewers"
        ],
        "properties": {
          "schema_version": {"const": "fathomdb.cuda-unmerged-candidate/v1"},
          "candidate_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
          "candidate_pr": {"minimum": 1, "type": "integer"},
          "candidate_pr_head_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
          "required_reviewers": {
            "minItems": 1,
            "items": {"minLength": 1, "type": "string"},
            "type": "array",
            "uniqueItems": true
          },
          "expires_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"},
          "purpose": {"const": "0.8.23 non-publishing CUDA preflight"},
          "provenance_pr": {"minimum": 1, "type": "integer"},
          "provenance_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
          "provenance_required_reviewers": {
            "minItems": 1,
            "items": {"minLength": 1, "type": "string"},
            "type": "array",
            "uniqueItems": true
          }
        }
      }
    }
  }
}
