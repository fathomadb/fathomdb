 "campaign": "COMP-03",
 "claim_boundary": {
  "statement": "paired answer accuracy on 250 LongMemEval-S questions in the full-500 type mix: FathomDB FTS (pack_context T5/A0/k50, query stop words had/long/suggest) minus LanceDB FTS (Slice 40 mix renderer); each arm keeps its own renderer, so this compares shipped paths, not stores",
  "reuse": "the pinned 60 reuse the M3 (pa-m3) and mix (comp03-run-mix) answers when reader, judge, seeds, prompts and evidence policy match; reused answers are marked in the receipt"
 },
 "corpus": {
  "identifier": "longmemeval-s-cleaned",
