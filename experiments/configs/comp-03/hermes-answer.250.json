  "storage": "external_only"
 },
 "document_unit": {
  "blank_rounds": "blank (whitespace-only) rounds are not indexed by any arm; round IDs stay positional, so every other round's ID and the gold are unchanged; the count is recorded per question as blank_rounds_skipped",
  "excluded": [
   "answer",
   "answer_session_ids",
   "haystack_session_ids",
   "has_answer"
  ],
  "id": "s<session position:03d>-r<round position:03d>",
  "indexed_body": "turn contents joined by newline",
  "rule": "one user turn plus the assistant turns that follow it; leading assistant turns form their own round",
  "unit": "round"
 },
 "evidence": {
  "renderer": "per arm (arms[].evidence)",
  "recency_instruction": false
 },
 "live": {
  "route": "Airlock loopback http://127.0.0.1:4000, OpenAI upstream",
  "answerer": {
   "model": "openai/gpt-5.4",
   "prompt": "LongMemEval reading prompt (comp03_answer.answer_messages)",
   "max_tokens": 1024,
   "input_usd_per_million": 2.5,
   "output_usd_per_million": 15.0
  },
  "judge": {
   "model": "openai/gpt-5.4",
   "prompt": "LongMemEval evaluate_qa per-type answer check, blinded to product",
   "max_tokens": 16,
   "input_usd_per_million": 2.5,
   "output_usd_per_million": 15.0
  },
  "temperature": 0,
  "seed": 0,
  "max_usd": 15.0,
  "max_retries": 4,
  "ceiling_usd": 11.5,
  "question_usd_estimate": 0.06,
  "ceiling_rule": "before a question that needs any model call, stop if this run's spend (reused calls excluded) plus max(question_usd_estimate, the largest per-question spend so far) exceeds ceiling_usd; rerun to resume"
 },
 "metrics": [
  "answer_accuracy_paired",
