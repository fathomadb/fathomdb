diff --git a/tests/test_memory01_resilience.py b/tests/test_memory01_resilience.py
new file mode 100644
index 0000000..9d727e4
--- /dev/null
+++ b/tests/test_memory01_resilience.py
@@ -0,0 +1,123 @@
+from __future__ import annotations
+
+import asyncio
+import json
+from datetime import UTC, datetime, timedelta
+from email.utils import format_datetime
+from types import SimpleNamespace
+
+from aiolimiter import AsyncLimiter
+
+from benchmarks.common.llm_client import LLMClient
+from benchmarks.common.mem0_client import Mem0Client
+from benchmarks.common.retry import retry_delay_seconds
+from benchmarks.locomo.run import ingest_conversation
+
+
+def test_mem0_client_uses_declared_rpm() -> None:
+    client = Mem0Client(rpm=17)
+
+    assert client.limiter.max_rate == 1
+    assert client.limiter.time_period == 60 / 17
+
+
+def test_llm_client_evenly_paces_declared_rpm() -> None:
+    client = LLMClient(model="gpt-4o-mini", api_key="test", rpm=19)
+
+    assert client.limiter.max_rate == 1
+    assert client.limiter.time_period == 60 / 19
+
+
+def test_retry_delay_prefers_numeric_retry_after() -> None:
+    error = SimpleNamespace(headers={"Retry-After": "23"})
+
+    assert retry_delay_seconds(error, fallback_seconds=4) == 23
+
+
+def test_retry_delay_accepts_http_date() -> None:
+    now = datetime.now(UTC)
+    error = SimpleNamespace(
+        headers={"Retry-After": format_datetime(now + timedelta(seconds=31))}
+    )
+
+    delay = retry_delay_seconds(error, fallback_seconds=4, now=now)
+
+    assert 30 <= delay <= 31
+
+
+def test_llm_retry_sleeps_for_retry_after(monkeypatch) -> None:
+    class RateLimited(Exception):
+        headers = {"Retry-After": "19"}
+
+    class Completions:
+        attempts = 0
+
+        async def create(self, **kwargs):
+            self.attempts += 1
+            if self.attempts == 1:
+                raise RateLimited("slow down")
+            return SimpleNamespace(
+                choices=[
+                    SimpleNamespace(
+                        message=SimpleNamespace(content="done"),
+                        finish_reason="stop",
+                    )
+                ]
+            )
+
+    sleeps: list[float] = []
+
+    async def record_sleep(seconds: float) -> None:
+        sleeps.append(seconds)
+
+    client = LLMClient.__new__(LLMClient)
+    client.model = "gpt-4o-mini"
+    client.max_retries = 2
+    client.timeout = 30
+    client.limiter = AsyncLimiter(20, 60)
+    client._client = SimpleNamespace(
+        chat=SimpleNamespace(completions=Completions())
+    )
+    monkeypatch.setattr(asyncio, "sleep", record_sleep)
+
+    result = asyncio.run(
+        client._generate_openai("system", "user", temperature=0, max_tokens=10)
+    )
+
+    assert result == "done"
+    assert sleeps == [19]
+
+
+def test_failed_ingestion_chunk_remains_resumable(tmp_path) -> None:
+    class FailedMem0:
+        async def add(self, *args, **kwargs):
+            return None
+
+    entry = {
+        "conversation": {
+            "speaker_a": "A",
+            "speaker_b": "B",
+            "session_1_date_time": "1:00 pm on 1 May, 2023",
+            "session_1": [{"speaker": "A", "text": "remember this"}],
+        }
+    }
+
+    success, _, completed = asyncio.run(
+        ingest_conversation(
+            0,
+            entry,
+            FailedMem0(),
+            SimpleNamespace(info=lambda *args: None, warning=lambda *args: None),
+            "run",
+            "project",
+            str(tmp_path),
+            SimpleNamespace(requested=False),
+            debug=False,
+        )
+    )
+
+    assert success is False
+    assert completed == 0
+    assert not (tmp_path / "_ingestion_0.json").exists()
+    progress = json.loads((tmp_path / "_progress_0.json").read_text())
+    assert progress["completed_chunks"] == []
