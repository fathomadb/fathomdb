diff --git a/benchmarks/common/retry.py b/benchmarks/common/retry.py
new file mode 100644
index 0000000..a41e1f4
--- /dev/null
+++ b/benchmarks/common/retry.py
@@ -0,0 +1,46 @@
+"""Retry helpers shared by benchmark HTTP and model clients."""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime
+from email.utils import parsedate_to_datetime
+from typing import Any, Mapping
+
+
+def _headers(error: object) -> Mapping[str, Any]:
+    headers = getattr(error, "headers", None)
+    if headers is None:
+        response = getattr(error, "response", None)
+        headers = getattr(response, "headers", None)
+    return headers if isinstance(headers, Mapping) else {}
+
+
+def retry_delay_seconds(
+    error: object,
+    *,
+    fallback_seconds: float,
+    now: datetime | None = None,
+) -> float:
+    """Return Retry-After when present, otherwise the caller's fallback."""
+    value = next(
+        (
+            raw
+            for key, raw in _headers(error).items()
+            if str(key).lower() == "retry-after"
+        ),
+        None,
+    )
+    if value is None:
+        return max(0.0, float(fallback_seconds))
+    try:
+        return max(0.0, float(value))
+    except (TypeError, ValueError):
+        pass
+    try:
+        target = parsedate_to_datetime(str(value))
+        if target.tzinfo is None:
+            target = target.replace(tzinfo=UTC)
+        current = now or datetime.now(UTC)
+        return max(0.0, (target - current).total_seconds())
+    except (TypeError, ValueError, OverflowError):
+        return max(0.0, float(fallback_seconds))
