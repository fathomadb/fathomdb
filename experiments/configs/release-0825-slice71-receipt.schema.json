{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slice71ReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_sha256", "candidate_ref", "started_at", "finished_at", "cells", "classifications", "errors"],
  "properties": {
    "schema_version": {"const": "slice71-receipt.v1"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workload", "arm", "ref", "ordinal", "started_at", "finished_at", "process_identity", "build_identity", "host_identity", "runtime_identity", "environment_observation", "fixture_sha256", "config_sha256", "raw_log_sha256", "result_state", "error", "metrics"],
        "properties": {
          "workload": {"enum": ["ac013", "ingest"]},
          "arm": {"enum": ["B", "C", "production", "counter_only", "nonce_only", "no_op"]},
          "ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "ordinal": {"type": "integer", "minimum": 1},
          "started_at": {"type": "string"},
          "finished_at": {"type": "string"},
          "process_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fresh_process", "test_threads"],
            "properties": {
              "fresh_process": {"const": true},
              "test_threads": {"const": 1}
            }
          },
          "build_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile", "rustc", "llvm"],
            "properties": {
              "profile": {"const": "release"},
              "rustc": {"type": "string", "minLength": 1},
              "llvm": {"type": "string", "minLength": 1}
            }
          },
          "host_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "kernel", "arch", "online_cpus"],
            "properties": {
              "host": {"type": "string", "minLength": 1},
              "kernel": {"type": "string", "minLength": 1},
              "arch": {"type": "string", "minLength": 1},
              "online_cpus": {"type": "integer", "minimum": 1}
            }
          },
          "runtime_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sqlite_version", "libsqlite3_sys"],
            "properties": {
              "sqlite_version": {"type": "string", "minLength": 1},
              "libsqlite3_sys": {"type": "string", "minLength": 1}
            }
          },
          "environment_observation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["load_1m_start", "load_1m_end", "available_memory_percent_start", "available_memory_percent_end", "swap_in_delta", "swap_out_delta", "cpu_temp_c_start", "cpu_temp_c_end", "thermal_throttled", "competing_processes_start", "competing_processes_end"],
            "properties": {
              "load_1m_start": {"type": "number", "minimum": 0},
              "load_1m_end": {"type": "number", "minimum": 0},
              "available_memory_percent_start": {"type": "number", "minimum": 0, "maximum": 100},
              "available_memory_percent_end": {"type": "number", "minimum": 0, "maximum": 100},
              "swap_in_delta": {"type": "integer", "minimum": 0},
              "swap_out_delta": {"type": "integer", "minimum": 0},
              "cpu_temp_c_start": {"type": "number", "minimum": 0},
              "cpu_temp_c_end": {"type": "number", "minimum": 0},
              "thermal_throttled": {"type": "boolean"},
              "competing_processes_start": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "competing_processes_end": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          },
          "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "raw_log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "result_state": {"enum": ["passed", "failed", "insufficient_samples", "environment_invalid"]},
          "error": {"type": ["string", "null"]},
          "metrics": {
            "oneOf": [
              {"$ref": "#/$defs/ac013_metrics"},
              {"$ref": "#/$defs/ingest_metrics"}
            ]
          }
        }
      }
    },
    "classifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ac013", "ingest"],
      "properties": {
        "ac013": {"enum": ["both_pass", "candidate_regression", "candidate_recovery", "pre_existing_gate_failure", "environment_invalid", "insufficient_samples"]},
        "ingest": {"enum": ["within_limit", "regression_attributed", "blocked_before_execution", "environment_invalid", "insufficient_samples"]}
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "ac013_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "samples", "vector_dim", "seed_write_ms", "projection_drain_ms", "p50_ms", "p99_ms"],
      "properties": {
        "n": {"type": "integer"},
        "samples": {"type": "integer"},
        "vector_dim": {"type": "integer"},
        "seed_write_ms": {"type": "integer"},
        "projection_drain_ms": {"type": "integer"},
        "p50_ms": {"type": "number"},
        "p99_ms": {"type": "number"}
      }
    },
    "ingest_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_rows", "batch_size", "ingest_ack_ms", "projection_drain_ms", "row_counts", "trigger_inventory", "visibility_state", "visibility_reason", "generation_before", "generation_after", "generation_delta", "nonce_before", "nonce_after", "database_bytes", "wal_bytes", "cpu_seconds", "peak_rss_bytes", "load_average", "available_memory_percent", "swap_io_delta", "thermal_throttled"],
      "properties": {
        "corpus_rows": {"type": "integer"},
        "batch_size": {"type": "integer"},
        "ingest_ack_ms": {"type": "number"},
        "projection_drain_ms": {"type": "number"},
        "row_counts": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "trigger_inventory": {"type": "integer"},
        "visibility_state": {"enum": ["observed", "not_applicable"]},
        "visibility_reason": {"type": ["string", "null"]},
        "generation_before": {"type": ["integer", "null"]},
        "generation_after": {"type": ["integer", "null"]},
        "generation_delta": {"type": ["integer", "null"]},
        "nonce_before": {"type": ["string", "null"]},
        "nonce_after": {"type": ["string", "null"]},
        "database_bytes": {"type": "integer"},
        "wal_bytes": {"type": "integer"},
        "cpu_seconds": {"type": "number"},
        "peak_rss_bytes": {"type": "integer"},
        "load_average": {"type": "number"},
        "available_memory_percent": {"type": "number"},
        "swap_io_delta": {"type": "integer"},
        "thermal_throttled": {"type": "boolean"}
      }
    }
  }
}
