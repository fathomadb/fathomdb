{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slice71BAttributionManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "approval",
    "product_sources",
    "probe",
    "runner",
    "fixtures",
    "treatments",
    "attribution_order",
    "policy",
    "environment_policy",
    "raw_root"
  ],
  "properties": {
    "schema_version": {"const": "slice71b-attribution-manifest.v1"},
    "release": {"const": "0.8.25"},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "approved_by", "approved_at"],
      "properties": {
        "state": {"const": "approved"},
        "approved_by": {"const": "HITL"},
        "approved_at": {"type": "string", "minLength": 1}
      }
    },
    "product_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale02_baseline", "ac013_baseline", "unchanged_current"],
      "properties": {
        "scale02_baseline": {"const": "b2bfb1f318f58041144acb2356a6a4c9624068b9"},
        "ac013_baseline": {"const": "4fc1b890a11ebfaa8f11b15823656e856002807a"},
        "unchanged_current": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "probe": {"$ref": "#/$defs/file_binding"},
    "runner": {"$ref": "#/$defs/file_binding"},
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale02", "ac013"],
      "properties": {
        "scale02": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_jsonl", "input_sha256", "fixture_sha256", "sizes", "batch_size_small", "batch_size_10k", "embedder"],
          "properties": {
            "input_jsonl": {"type": "string", "minLength": 1},
            "input_sha256": {"$ref": "#/$defs/sha256"},
            "fixture_sha256": {"$ref": "#/$defs/sha256"},
            "sizes": {"const": [1, 10, 100, 1000, 10000]},
            "batch_size_small": {"const": "one_transaction"},
            "batch_size_10k": {"const": 256},
            "embedder": {"const": "none"}
          }
        },
        "ac013": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generator", "generator_sha256", "fixture_sha256", "sizes", "batch_size_small", "batch_size_10k", "vector_dim", "embedder"],
          "properties": {
            "generator": {"type": "string", "minLength": 1},
            "generator_sha256": {"$ref": "#/$defs/sha256"},
            "fixture_sha256": {"$ref": "#/$defs/sha256"},
            "sizes": {"const": [1, 10, 100, 1000, 10000]},
            "batch_size_small": {"const": "one_transaction"},
            "batch_size_10k": {"const": 1024},
            "vector_dim": {"const": 384},
            "embedder": {"const": "varying/perf-gates-dense"}
          }
        }
      }
    },
    "treatments": {"const": ["production", "generation_only", "no_op"]},
    "attribution_order": {"const": ["production", "generation_only", "no_op", "no_op", "generation_only", "production", "generation_only", "production", "no_op"]},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repetitions_per_arm", "max_within_arm_spread_percent", "ten_k_limit_percent", "small_limit_percent", "small_absolute_floor_ms", "conditional_preparation_factorial"],
      "properties": {
        "repetitions_per_arm": {"const": 3},
        "max_within_arm_spread_percent": {"const": 25},
        "ten_k_limit_percent": {"const": 20},
        "small_limit_percent": {"const": 10},
        "small_absolute_floor_ms": {"const": 0.25},
        "conditional_preparation_factorial": {"const": "only_if_three_arm_attribution_is_unresolved"}
      }
    },
    "environment_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_load_per_online_cpu", "min_available_memory_percent", "max_swap_io_delta", "max_cpu_temp_c", "thermal_signal", "forbid_competing_processes"],
      "properties": {
        "max_load_per_online_cpu": {"const": 0.5},
        "min_available_memory_percent": {"const": 25},
        "max_swap_io_delta": {"const": 0},
        "max_cpu_temp_c": {"const": 90},
        "thermal_signal": {"const": "k10temp:Tctl"},
        "forbid_competing_processes": {"const": true}
      }
    },
    "raw_root": {"const": "dev/plans/runs/0.8.25-slice-71/71b"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
