{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slice71BAttributionReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_sha256", "started_at", "finished_at", "cells", "classification", "errors"],
  "properties": {
    "schema_version": {"const": "slice71b-attribution-receipt.v1"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "cells": {
      "type": "array",
      "maxItems": 18,
      "items": {"$ref": "#/$defs/cell"}
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "supported_causes", "conditional_preparation_factorial_required"],
      "properties": {
        "state": {"enum": ["supported", "unresolved", "environment_invalid", "probe_failed", "build_failed", "spread_invalid"]},
        "supported_causes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["per_row_visibility_update", "per_fire_nonce"]}
        },
        "conditional_preparation_factorial_required": {"type": "boolean"}
      }
    },
    "errors": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "treatment", "ordinal", "source_ref", "source_tree_dirty", "probe_sha256", "probe_lock_sha256", "runner_sha256", "executable_sha256", "executable_path", "fixture_sha256", "started_at", "finished_at", "environment_valid", "environment_sha256", "environment_path", "raw_log_sha256", "raw_log_path", "build_identity", "runtime_identity", "metrics"],
      "properties": {
        "fixture": {"enum": ["scale02", "ac013"]},
        "treatment": {"enum": ["production", "generation_only", "no_op"]},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 3},
        "source_ref": {"$ref": "#/$defs/sha1"},
        "source_tree_dirty": {"const": false},
        "probe_sha256": {"$ref": "#/$defs/sha256"},
        "probe_lock_sha256": {"$ref": "#/$defs/sha256"},
        "runner_sha256": {"$ref": "#/$defs/sha256"},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "executable_path": {"type": "string", "minLength": 1},
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "started_at": {"type": "string", "minLength": 1},
        "finished_at": {"type": "string", "minLength": 1},
        "environment_valid": {"const": true},
        "environment_sha256": {"$ref": "#/$defs/sha256"},
        "environment_path": {"type": "string", "minLength": 1},
        "raw_log_sha256": {"$ref": "#/$defs/sha256"},
        "raw_log_path": {"type": "string", "minLength": 1},
        "build_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cargo", "rustc", "rustc_verbose_sha256", "profile"],
          "properties": {
            "cargo": {"type": "string", "minLength": 1},
            "rustc": {"type": "string", "minLength": 1},
            "rustc_verbose_sha256": {"$ref": "#/$defs/sha256"},
            "profile": {"const": "release"}
          }
        },
        "runtime_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sqlite_version", "sqlite_source_id", "libsqlite3_sys"],
          "properties": {
            "sqlite_version": {"type": "string", "minLength": 1},
            "sqlite_source_id": {"type": "string", "minLength": 1},
            "libsqlite3_sys": {"type": "string", "minLength": 1}
          }
        },
        "metrics": {"$ref": "#/$defs/metrics"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records", "batch_size", "transactions", "ingest_ack_ms", "projection_drain_ms", "total_ms", "generation_before", "generation_after_ack", "generation_after_drain", "nonce_before", "nonce_after_ack", "nonce_after_drain", "trigger_inventory", "database_bytes", "wal_bytes", "process_cpu_seconds", "peak_rss_bytes"],
      "properties": {
        "records": {"const": 10000},
        "batch_size": {"enum": [256, 1024]},
        "transactions": {"enum": [10, 40]},
        "ingest_ack_ms": {"type": "number", "exclusiveMinimum": 0},
        "projection_drain_ms": {"type": "number", "exclusiveMinimum": 0},
        "total_ms": {"type": "number", "exclusiveMinimum": 0},
        "generation_before": {"type": ["integer", "null"], "minimum": 0},
        "generation_after_ack": {"type": ["integer", "null"], "minimum": 0},
        "generation_after_drain": {"type": ["integer", "null"], "minimum": 0},
        "nonce_before": {"$ref": "#/$defs/nullable_sha256"},
        "nonce_after_ack": {"$ref": "#/$defs/nullable_sha256"},
        "nonce_after_drain": {"$ref": "#/$defs/nullable_sha256"},
        "trigger_inventory": {"type": "integer", "minimum": 0},
        "database_bytes": {"type": "integer", "minimum": 0},
        "wal_bytes": {"type": "integer", "minimum": 0},
        "process_cpu_seconds": {"type": "number", "exclusiveMinimum": 0},
        "peak_rss_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
