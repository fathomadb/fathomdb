#!/usr/bin/env bash
# fathomdb-tracked-hook: scripts/hooks (managed by scripts/install-hooks.sh)
# Advisory inspection of the final proposed commit message. This is commit-msg,
# not pre-commit: Git has not obtained the proposed message when pre-commit runs.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [ -x scripts/warn-ci-skip-message.sh ]; then
  scripts/warn-ci-skip-message.sh --source "commit message" "$1"
elif [ -f scripts/warn-ci-skip-message.sh ]; then
  bash scripts/warn-ci-skip-message.sh --source "commit message" "$1"
fi
