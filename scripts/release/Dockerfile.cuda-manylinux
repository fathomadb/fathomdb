# syntax=docker/dockerfile:1
# The pinned manylinux base provides CPython 3.11 at the path consumed by the
# release preflight. CUDA is copied from a separately pinned vendor image so
# neither CUDA nor the manylinux policy is inherited from a mutable tag.
FROM nvidia/cuda:12.6.3-devel-rockylinux8@sha256:83bc2b9fcf3ab1a4e324f81e962b58957370fa71f7ac61e3a24af399a0ba7595 AS cuda

FROM quay.io/pypa/manylinux_2_28_x86_64@sha256:aba9efd7dec389abd76506219e461014015b1c1cb95f2a36f27946128910dd07

ARG RUST_VERSION=1.95.0
ARG MATURIN_VERSION=1.14.1
ARG CUDA_GCC_TOOLSET=gcc-toolset-13
ARG CUDA_GCC_VERSION=13.3.1
ARG RUSTUP_INIT_URL=https://static.rust-lang.org/rustup/archive/1.29.0/x86_64-unknown-linux-gnu/rustup-init
ARG RUSTUP_INIT_SHA256=4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10

LABEL io.fathomdb.cuda.manylinux-base=quay.io/pypa/manylinux_2_28_x86_64@sha256:aba9efd7dec389abd76506219e461014015b1c1cb95f2a36f27946128910dd07 \
      io.fathomdb.cuda.toolkit-base=nvidia/cuda:12.6.3-devel-rockylinux8@sha256:83bc2b9fcf3ab1a4e324f81e962b58957370fa71f7ac61e3a24af399a0ba7595 \
      io.fathomdb.cuda.toolkit=12.6.3 \
      io.fathomdb.cuda.manylinux=2_28 \
      io.fathomdb.cuda.python=cp311-cp311 \
      io.fathomdb.cuda.rust=$RUST_VERSION \
      io.fathomdb.cuda.maturin=$MATURIN_VERSION \
      io.fathomdb.cuda.compiler=$CUDA_GCC_TOOLSET \
      io.fathomdb.cuda.compiler-version=$CUDA_GCC_VERSION \
      io.fathomdb.cuda.rustup-init-sha256=$RUSTUP_INIT_SHA256

COPY --from=cuda /usr/local/cuda-12.6 /usr/local/cuda-12.6

ENV CUDA_PATH=/usr/local/cuda-12.6 \
    CUDACXX=/usr/local/cuda-12.6/bin/nvcc \
    CC=/opt/rh/gcc-toolset-13/root/usr/bin/gcc \
    CXX=/opt/rh/gcc-toolset-13/root/usr/bin/g++ \
    CUDAHOSTCXX=/opt/rh/gcc-toolset-13/root/usr/bin/g++ \
    CARGO_HOME=/root/.cargo \
    RUSTUP_HOME=/root/.rustup \
    PATH=/opt/rh/gcc-toolset-13/root/usr/bin:/root/.cargo/bin:/usr/local/cuda-12.6/bin:$PATH

RUN dnf install -y gcc-toolset-13-gcc gcc-toolset-13-gcc-c++ \
    && dnf clean all \
    && curl --proto '=https' --tlsv1.2 --fail --silent --show-error --output /tmp/rustup-init "$RUSTUP_INIT_URL" \
    && printf '%s  %s\n' "$RUSTUP_INIT_SHA256" /tmp/rustup-init | sha256sum --check --status \
    && chmod 0755 /tmp/rustup-init \
    && /tmp/rustup-init -y --profile minimal --default-toolchain "$RUST_VERSION" \
    && rm /tmp/rustup-init \
    && cargo install maturin --version "$MATURIN_VERSION" --locked \
    && test -x /opt/python/cp311-cp311/bin/python \
    && /opt/python/cp311-cp311/bin/python --version \
    && rustc --version | grep -F "rustc $RUST_VERSION" \
    && maturin --version | grep -F "maturin $MATURIN_VERSION" \
    && "$CC" --version | grep -F "$CUDA_GCC_VERSION" \
    && "$CXX" --version | grep -F "$CUDA_GCC_VERSION" \
    && test "$CUDAHOSTCXX" = "$CXX" \
    && /usr/local/cuda-12.6/bin/nvcc --version | grep -F 'release 12.6'
