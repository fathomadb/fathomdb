{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fathomdb.dev/schemas/cuda-package-rehearsal/v1",
  "title": "FathomDB CUDA package rehearsal",
  "description": "A SHA-bound, non-publishing inventory of exact CUDA package bytes and installed-artifact smoke evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "build_input",
    "candidate_sha",
    "packages",
    "preflight_witness_sha256",
    "route_receipt_sha256",
    "schema_version",
    "smoke_evidence_sha256"
  ],
  "properties": {
    "schema_version": {"const": "fathomdb.cuda-package-rehearsal/v1"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "route_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "preflight_witness_sha256": {"$ref": "#/$defs/sha256"},
    "build_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_sha", "napi_features", "python_features", "rerank_cuda", "schema_version"],
      "properties": {
        "schema_version": {"const": "fathomdb.cuda-package-build-input/v1"},
        "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "python_features": {"const": ["embed-cuda", "pyo3/extension-module"]},
        "napi_features": {"const": ["default-embedder", "embed-cuda"]},
        "rerank_cuda": {"const": false}
      }
    },
    "packages": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "smoke_evidence_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu-napi.json", "cpu-python.json", "gpu-napi.json", "gpu-python.json"],
      "properties": {
        "cpu-napi.json": {"$ref": "#/$defs/sha256"},
        "cpu-python.json": {"$ref": "#/$defs/sha256"},
        "gpu-napi.json": {"$ref": "#/$defs/sha256"},
        "gpu-python.json": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
