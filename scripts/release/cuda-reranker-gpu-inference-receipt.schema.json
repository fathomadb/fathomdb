{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fathomdb.dev/schemas/cuda-reranker-gpu-inference-receipt/v1",
  "title": "FathomDB installed CUDA reranker inference receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_sha", "consumer", "target", "requested_policy", "status", "effective_device", "visible_devices", "selected_uuid", "nvidia_smi_uuid", "process_id", "nvidia_smi_compute_process_id", "model_cache_manifest_sha256", "rerank_performed", "network", "source_imported"],
  "properties": {
    "schema_version": {"const": "fathomdb.cuda-reranker-gpu-inference-receipt/v1"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "consumer": {"const": "cli"},
    "target": {"const": "x86_64-unknown-linux-gnu"},
    "requested_policy": {"const": "cuda:0"},
    "status": {"const": "selected_cuda"},
    "effective_device": {"const": "cuda:0"},
    "visible_devices": {"type": "array", "minItems": 1, "maxItems": 1},
    "selected_uuid": {"type": "string", "minLength": 1},
    "nvidia_smi_uuid": {"type": "string", "minLength": 1},
    "process_id": {"type": "integer", "minimum": 1},
    "nvidia_smi_compute_process_id": {"type": "integer", "minimum": 1},
    "model_cache_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rerank_performed": {"const": true},
    "network": {"const": "none"},
    "source_imported": {"const": false}
  }
}
