{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FathomDB unmerged CUDA route receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_ref",
    "workflow_sha",
    "run_id",
    "run_attempt",
    "manifest_sha256",
    "candidate_sha",
    "candidate_pr",
    "approval_review_ids",
    "api_response_sha256"
  ],
  "properties": {
    "schema_version": {"const": "fathomdb.cuda-unmerged-route-receipt/v1"},
    "workflow_ref": {"const": "fathomadb/fathomdb/.github/workflows/release.yml@refs/heads/main"},
    "workflow_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "run_id": {"minimum": 1, "type": "integer"},
    "run_attempt": {"minimum": 1, "type": "integer"},
    "manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "candidate_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "candidate_pr": {"minimum": 1, "type": "integer"},
    "approval_review_ids": {"minItems": 1, "items": {"minimum": 1, "type": "integer"}, "type": "array", "uniqueItems": true},
    "api_response_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protection_baseline", "pull_request", "reviews"],
      "properties": {
        "protection_baseline": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "pull_request": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "reviews": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      }
    }
  }
}
