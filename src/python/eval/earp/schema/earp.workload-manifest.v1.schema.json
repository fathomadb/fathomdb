{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "earp.workload-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "quality_parent", "resolved_config", "workload", "performance_plan"],
  "properties": {
    "schema_version": {"const": "earp.workload-manifest.v1"},
    "quality_parent": {"type": "object", "additionalProperties": false, "required": ["run_id", "evidence_family_id", "result_path", "result_sha256", "candidate_sha", "clean"], "properties": {"run_id": {"type": "string"}, "evidence_family_id": {"type": "string"}, "result_path": {"type": "string"}, "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "candidate_sha": {"type": "string"}, "clean": {"type": "boolean"}}},
    "resolved_config": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "canonical_json"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "canonical_json": {"type": "string"}}},
    "workload": {"type": "object", "additionalProperties": false, "required": ["config_sha256", "query_call", "effective_knobs"], "properties": {"config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "query_call": {"type": "string"}, "effective_knobs": {"type": "object"}, "retrieval_mode": {"type": "string"}, "max_measurable_k": {"type": "integer", "minimum": 1}, "use_default_embedder": {"type": "boolean"}, "corpus": {"type": "object"}, "gold": {"type": "object"}, "projections": {"type": "object"}, "embedder": {"type": "object"}, "device": {"type": "object"}}},
    "performance_plan": {"type": "object", "additionalProperties": false, "required": ["treatments", "repetitions", "warmup_rule", "aggregation_rule", "invalid_result_policy", "command"], "properties": {"kind": {"enum": ["descriptive_nonclaim", "predeclared_repeated"]}, "treatments": {"type": "array", "items": {"type": "string"}}, "repetitions": {"type": "integer", "minimum": 1}, "warmup_rule": {"type": "string"}, "aggregation_rule": {"type": "string"}, "invalid_result_policy": {"type": "string"}, "command": {"type": "string"}}}
  }
}
