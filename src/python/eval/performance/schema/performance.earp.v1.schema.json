{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "performance.earp.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "scope", "relation", "quality_workload_sha256", "execution_workload_sha256", "workload", "plan", "parent_manifest", "inputs", "cells", "samples", "summary"],
  "properties": {
    "schema_version": {"const": "performance.earp.v1"},
    "run_id": {"type": "string"},
    "scope": {"const": "repeated_performance_characterization"},
    "relation": {"enum": ["same_candidate_reexecution", "cross_candidate_reexecution"]},
    "quality_workload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_workload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workload": {"type": "object"},
    "plan": {"type": "object"},
    "parent_manifest": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "inputs": {"type": "object", "additionalProperties": false, "required": ["quality_result", "resolved_config"], "properties": {"quality_result": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}, "resolved_config": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}},
    "cells": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["treatment", "repetition", "status", "raw_samples", "execution_provenance"], "properties": {"treatment": {"type": "string"}, "repetition": {"type": "integer", "minimum": 0}, "status": {"enum": ["complete", "invalid"]}, "raw_samples": {"type": "array", "items": {"$ref": "#/$defs/raw_sample"}}, "execution_provenance": {"type": "object"}, "invalidity": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}}},
    "samples": {"type": "array", "items": {"$ref": "#/$defs/raw_sample"}},
    "summary": {"type": "object"}
  },
  "$defs": {
    "raw_sample": {"type": "object", "additionalProperties": false, "required": ["treatment", "repetition", "phases_ms", "counts"], "properties": {"treatment": {"type": "string"}, "repetition": {"type": "integer", "minimum": 0}, "phases_ms": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}}, "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "treatment_witness": {"type": "object"}}}
  }
}
